import { useState } from 'react';
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Check, X, Trash2, CreditCard, Undo2, Plus } from "lucide-react";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

type Order = {
  id: string;
  customerName: string;
  orderDetails: string;
  price: number;
  isPaid: boolean;
  date: string;
};

export default function SantwanOrders() {
  const [orders, setOrders] = useState<Order[]>([
    {
      id: '1',
      customerName: 'احمد',
      orderDetails: 'قيرة - ساندويتش',
      price: 25,
      isPaid: true,
      date: '2023-10-15'
    },
    {
      id: '2',
      customerName: 'محمد',
      orderDetails: '2 های وکیل',
      price: 15,
      isPaid: false,
      date: '2023-10-15'
    },
    {
      id: '3',
      customerName: 'ala',
      orderDetails: 'سلطة عصير',
      price: 30,
      isPaid: true,
      date: '2023-10-14'
    }
  ]);

  const [selectedDate, setSelectedDate] = useState<string>(new Date().toISOString().split('T')[0]);
  const [newOrder, setNewOrder] = useState<Omit<Order, 'id'>>({
    customerName: '',
    orderDetails: '',
    price: 0,
    isPaid: false,
    date: new Date().toISOString().split('T')[0]
  });
  
  const [showAddForm, setShowAddForm] = useState(false);

  const addOrder = () => {
    if (!newOrder.customerName || !newOrder.orderDetails || newOrder.price <= 0) return;
    
    const order: Order = {
      ...newOrder,
      id: Date.now().toString()
    };
    
    setOrders([...orders, order]);
    setNewOrder({
      customerName: '',
      orderDetails: '',
      price: 0,
      isPaid: false,
      date: new Date().toISOString().split('T')[0]
    });
    setShowAddForm(false);
  };

  const deleteOrder = (id: string) => {
    setOrders(orders.filter(order => order.id !== id));
  };

  const markAsPaid = (id: string) => {
    setOrders(orders.map(order => 
      order.id === id ? { ...order, isPaid: true } : order
    ));
  };

  const markAsUnpaid = (id: string) => {
    setOrders(orders.map(order => 
      order.id === id ? { ...order, isPaid: false } : order
    ));
  };

  const filteredOrders = orders.filter(order => order.date === selectedDate);
  const unpaidPastOrders = orders.filter(order => 
    !order.isPaid && 
    new Date(order.date).getTime() < new Date(selectedDate).getTime()
  );
  
  const filteredOrdersTotal = filteredOrders.reduce((sum, order) => sum + order.price, 0);
  const filteredPaidTotal = filteredOrders
    .filter(order => order.isPaid)
    .reduce((sum, order) => sum + order.price, 0);
  const filteredUnpaidTotal = filteredOrders
    .filter(order => !order.isPaid)
    .reduce((sum, order) => sum + order.price, 0);

  return (
    <div className="min-h-screen bg-gray-50 p-4 md:p-8">
      <div className="max-w-6xl mx-auto">
        <h1 className="text-3xl font-bold text-center mb-8">santwan</h1>
        
        <div className="mb-6 flex justify-end">
          <Button onClick={() => setShowAddForm(!showAddForm)}>
            <Plus className="h-4 w-4 mx-2" />
            {showAddForm ? 'إخفاء نموذج الإضافة' : 'إضافة طلب جديد'}
          </Button>
        </div>

        {showAddForm && (
          <Card className="mb-6">
            <CardHeader>
              <CardTitle>إضافة طلب جديد</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                  <Label htmlFor="customerName">اسم العميل</Label>
                  <Input
                    id="customerName"
                    value={newOrder.customerName}
                    onChange={(e) => setNewOrder({...newOrder, customerName: e.target.value})}
                  />
                </div>
                <div>
                  <Label htmlFor="orderDetails">تفاصيل الطلب</Label>
                  <Input
                    id="orderDetails"
                    value={newOrder.orderDetails}
                    onChange={(e) => setNewOrder({...newOrder, orderDetails: e.target.value})}
                  />
                </div>
                <div>
                  <Label htmlFor="price">السعر (درهم)</Label>
                  <Input
                    id="price"
                    type="number"
                    value={newOrder.price}
                    onChange={(e) => setNewOrder({...newOrder, price: Number(e.target.value)})}
                  />
                </div>
                <div>
                  <Label htmlFor="isPaid">حالة الدفع</Label>
                  <Select
                    value={newOrder.isPaid ? 'paid' : 'unpaid'}
                    onValueChange={(value) => setNewOrder({...newOrder, isPaid: value === 'paid'})}
                  >
                    <SelectTrigger>
                      <SelectValue placeholder="حالة الدفع" />
                    </SelectTrigger>
                    <SelectContent>
                      <SelectItem value="paid">تم الدفع</SelectItem>
                      <SelectItem value="unpaid">لم يتم الدفع</SelectItem>
                    </SelectContent>
                  </Select>
                </div>
              </div>
              <div className="mt-4">
                <Label htmlFor="date">تاريخ الطلب</Label>
                <Input
                  id="date"
                  type="date"
                  value={newOrder.date}
                  onChange={(e) => setNewOrder({...newOrder, date: e.target.value})}
                  className="w-full md:w-64"
                />
              </div>
              <div className="mt-4 flex justify-end space-x-2">
                <Button variant="outline" onClick={() => setShowAddForm(false)}>
                  الغاء
                </Button>
                <Button onClick={addOrder}>
                  إضافة الطلب
                </Button>
              </div>
            </CardContent>
          </Card>
        )}

        <Card className="mb-6">
          <CardHeader>
            <CardTitle>تقرير الطلبات حسب التاريخ</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="flex flex-col md:flex-row md:items-center gap-4">
              <div>
                <Label htmlFor="filterDate">اختر تاريخ</Label>
                <Input
                  id="filterDate"
                  type="date"
                  value={selectedDate}
                  onChange={(e) => setSelectedDate(e.target.value)}
                  className="w-full md:w-64"
                />
              </div>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mt-2 md:mt-0">
                <div className="bg-gray-100 p-3 rounded-lg">
                  <h3 className="font-semibold">إجمالي الطلبات</h3>
                  <p className="text-xl font-bold">{filteredOrdersTotal} درهم</p>
                </div>
                <div className="bg-green-100 p-3 rounded-lg">
                  <h3 className="font-semibold">المدفوع</h3>
                  <p className="text-xl font-bold">{filteredPaidTotal} درهم</p>
                </div>
                <div className="bg-red-100 p-3 rounded-lg">
                  <h3 className="font-semibold">غير المدفوع</h3>
                  <p className="text-xl font-bold">{filteredUnpaidTotal} درهم</p>
                </div>
              </div>
            </div>
          </CardContent>
        </Card>

        <Card className="mb-6">
          <CardHeader>
            <CardTitle>الطلبات ليوم {selectedDate}</CardTitle>
          </CardHeader>
          <CardContent>
            {filteredOrders.length === 0 ? (
              <p className="text-center py-4 text-gray-500">لا توجد طلبات لهذا التاريخ</p>
            ) : (
              <div className="overflow-x-auto">
                <table className="min-w-full divide-y divide-gray-200">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">العميل</th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">التفاصيل</th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">السعر</th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">الحالة</th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">الإجراءات</th>
                    </tr>
                  </thead>
                  <tbody className="bg-white divide-y divide-gray-200">
                    {filteredOrders.map((order) => (
                      <tr key={order.id}>
                        <td className="px-6 py-4 whitespace-nowrap text-right">{order.customerName}</td>
                        <td className="px-6 py-4 whitespace-nowrap text-right">{order.orderDetails}</td>
                        <td className="px-6 py-4 whitespace-nowrap text-right">{order.price} درهم</td>
                        <td className="px-6 py-4 whitespace-nowrap text-right">
                          {order.isPaid ? (
                            <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                              <Check className="h-3 w-3 ml-1" /> تم الدفع
                            </span>
                          ) : (
                            <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                              <X className="h-3 w-3 ml-1" /> لم يتم الدفع
                            </span>
                          )}
                        </td>
                        <td className="px-6 py-4 whitespace-nowrap text-right space-x-2">
                          {order.isPaid ? (
                            <Button
                              variant="secondary"
                              size="sm"
                              onClick={() => markAsUnpaid(order.id)}
                            >
                              <Undo2 className="h-4 w-4 ml-1" /> إرجاع
                            </Button>
                          ) : (
                            <Button
                              variant="default"
                              size="sm"
                              onClick={() => markAsPaid(order.id)}
                            >
                              <CreditCard className="h-4 w-4 ml-1" /> دفع
                            </Button>
                          )}
                          <Button
                            variant="destructive"
                            size="sm"
                            onClick={() => deleteOrder(order.id)}
                          >
                            <Trash2 className="h-4 w-4 ml-1" /> حذف
                          </Button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </CardContent>
        </Card>

        {unpaidPastOrders.length > 0 && (
          <Card>
            <CardHeader>
              <CardTitle>طلبات غير مدفوعة من تواريخ سابقة</CardTitle>
            </CardHeader>
            <CardContent>
              <div className="overflow-x-auto">
                <table className="min-w-full divide-y divide-gray-200">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">التاريخ</th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">العميل</th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">التفاصيل</th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">السعر</th>
                      <th className="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">الإجراءات</th>
                    </tr>
                  </thead>
                  <tbody className="bg-white divide-y divide-gray-200">
                    {unpaidPastOrders.map((order) => (
                      <tr key={order.id}>
                        <td className="px-6 py-4 whitespace-nowrap text-right">{order.date}</td>
                        <td className="px-6 py-4 whitespace-nowrap text-right">{order.customerName}</td>
                        <td className="px-6 py-4 whitespace-nowrap text-right">{order.orderDetails}</td>
                        <td className="px-6 py-4 whitespace-nowrap text-right">{order.price} درهم</td>
                        <td className="px-6 py-4 whitespace-nowrap text-right">
                          <Button
                            variant="default"
                            size="sm"
                            onClick={() => markAsPaid(order.id)}
                            className="ml-2"
                          >
                            <CreditCard className="h-4 w-4 ml-1" /> دفع
                          </Button>
                          <Button
                            variant="destructive"
                            size="sm"
                            onClick={() => deleteOrder(order.id)}
                          >
                            <Trash2 className="h-4 w-4 ml-1" /> حذف
                          </Button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>
        )}
      </div>
    </div>
  );
}
